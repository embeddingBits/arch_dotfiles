# packages.lst - categorized package list for Arch Linux
#
# Usage: install.sh reads groups from here
# Lines starting with # are comments.
# Lines beginning with @ are group headers.
# Packages can be shared across groups.

@core
mesa
libva-mesa-driver
dbus
polkit
wayland
wayland-protocols
wayland-utils
pkgconf
brightnessctl
libnotify
xdg-utils
zip
unzip
unrar

@repos
# Arch uses pacman.conf to enable [multilib] - handled in install.sh stage 2.
# No extra repository packages needed. Keep group for compatibility.
# Uncomment multilib manually or let install.sh do it.

@network
networkmanager
tailscale
wireguard-tools

@audio
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber
pavucontrol
bluez
bluez-utils

@desktop
niri
fuzzel
fnott
waybar
kitty
foot
zathura
tmux
fish
starship
nwg-look
wlr-randr
swaylock
wl-clipboard
wtype
swaybg
xdg-desktop-portal
xdg-desktop-portal-gtk
xdg-desktop-portal-gnome
xwayland-satellite
grim
slurp
hyprpicker

@tools
btop
fastfetch
cava
yazi
zoxide
ripgrep
fd
fzf
jq
bat
eza
playerctl
ffmpeg
gparted
mesa-utils

@app
telegram-desktop
element-desktop
obs-studio
mpv
firefox
lutris
steam

@dev
neovim
emacs
jdk21-openjdk
gcc-libs
gcc
zig
go
make
cmake
python
python-pip
typst
podman
podman-compose
