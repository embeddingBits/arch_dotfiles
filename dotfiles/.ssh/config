Host *
      AddKeysToAgent yes
      IdentitiesOnly yes
      IgnoreUnknown UseKeychain
      UseKeychain yes
      PreferredAuthentications publickey

Host github.com
      HostName github.com
      User git
      AddressFamily inet
      IdentityFile ~/.ssh/git

Host codeberg.org
      HostName codeberg.org
      User git
      AddressFamily inet
      IdentityFile ~/.ssh/git

