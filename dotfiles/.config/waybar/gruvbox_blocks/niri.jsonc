{
      "layer": "top",
      "position": "top", 
      "height": 25, 
      "spacing": 5, 
      "margin-left": 10,
      "margin-right": 10,
      "margin-top": 10,
      "modules-left": [
            "custom/launcher",    
            "niri/workspaces",
            "niri/window",
            "mpris"
      ],
      "modules-center": [
            "clock"
      ],
      "modules-right": [
            "wireplumber",
            "tray",
            "network",
            "memory",
            "backlight",
            "battery"
      ],

      "tray": {
            "icon-size": 21,
            "spacing": 10,
            "icons": {
                  "blueman": "bluetooth",
                  "TelegramDesktop": "$HOME/.local/share/icons/Gruvbox-Plus-Dark/apps/16/telegram-desktop.svg"
            }
      },
      "custom/launcher":{
            "format": "",
            "on-click": "rofi -show drun",
            "on-click-right": "killall rofi"
      },

      "niri/workspaces": {
            "sort-by": "number",
            "sort-by-number": true,
            "all-outputs": false,
            "format": "{icon}",
            "format-icons": {
                  "1": "  ",  
                  "2": " 󰈹 ",  
                  "3": "  ",  
                  "4": "  ",  
                  "5": "  "  
            }
      },

      "niri/window": {
            "format": "{app_id}",
            "rewrite": {
                  "": "󰣆  {}",
                  "firefox": "󰈹 Firefox",
                  "kitty": " Kitty",
                  "discord": "  Discord",
                  "emacs": " Emacs"
            }
      },

      "mpris": {
            "interval": 1,
            "format": "<span color='#a9b665'>{status_icon}</span> {artist} 󰎆 {title}",
            "format-disconnected": "Disconnected",
            "format-stopped": "{status_icon} Stopped",
            "ellipsis": "…",
            "title-len": 30,
            "player-icons": {
                  "default": "▶"
            },
            "status-icons": {
                  "paused": "",
                  "playing": "",
                  "stopped": ""
            }
      }, 
      "clock": {
            "tooltip-format": "󰥔 <big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
            "format": "<span color='#ea6962'>󰥔 </span>{:%a %d | %I:%M:%S %p}",
            "interval": 1
      },
      "cpu": {
            "format": "{usage}% ",
            "tooltip": false
      },
      "memory": {
            "format": "<span color='#E78A4E'>󰍛</span>{used: 0.2f} GB",
            "interval": 1
      },

      "temperature": {
            "critical-threshold": 80,
            "format": "{temperatureC}°C {icon}",
            "format-icons": ["", "", ""]
      },
      "backlight": {
            "format": "<span color='#a9b665'>{icon}</span> {percent}%",
            "format-icons": ["", "", "", "", "", "", "", "", ""]
      },
      "battery": {
            "states": {
                  "warning": 30,
                  "critical": 20
            },
            "events": {
                  "on-discharging-warning": "notify-send -u critical 'Low Battery'"
            },
            "format": "<span color='#D3869B'>{icon}</span> {capacity}%",
            "format-full": "<span color='#d3869b'>{icon}</span> {capacity}%",
            "format-charging": "<span color='#d3869b'> </span>{capacity}%",
            "format-plugged": "<span color='#d3869b'></span>{capacity}% ",
            "format-alt": "{time} {icon}",
            "format-icons": ["", "", "", "", ""],
            "interval": 1
      },
      "power-profiles-daemon": {
            "format": "{icon}",
            "tooltip-format": "Power profile: {profile}\nDhyprland: {dhyprland}",
            "tooltip": true,
            "format-icons": {
                  "default": "",
                  "performance": "",
                  "balanced": "",
                  "power-saver": ""
            }
      },
      "network": {
            "interface": "wlo1",
            "interval": 5,
            "format-wifi": "<span color='#D8A657'>{icon}</span> {essid}",
            "format-linked": "<span color='#D8A657'>{icon}</span> {essid}",
            "format-disconnected": "Disconnected ⚠",
            "format-alt": "{ifname}: {ipaddr}/{cidr}",
            "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"]
      },
      "wireplumber": {
            "format": "<span color='#7daea3'>{icon}</span>  {volume}%",
            "format-muted": "󰝟  {volume}%",
            "format-bluetooth": "<span color='#7daea3'>{icon}</span> {volume}%",
            "format-bluetooth-muted": "<span color='#ea6962'>󰂲 </span>{volume}%",
            "format-source-muted": "󰝟 ",
            "format-icons": {
                  "headphone": "",
                  "headset": " ",
                  "default": ["", "", ""]
            },
            "on-click": "pavucontrol"
      },
      "custom/power": {
            "format": "⏻ ",
            "tooltip": false,
            "menu": "on-click",
            "menu-file": "$HOME/.config/waybar/power_menu.xml",
            "menu-actions": {
                  "shutdown": "shutdown",
                  "reboot": "reboot",
                  "suspend": "systemctl suspend",
                  "hibernate": "systemctl hibernate"
            }
        }
}
