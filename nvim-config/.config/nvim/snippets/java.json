      "}"
    ],
    "description": "Class constructor"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "If conditional block"
  },
  "If Else": {
    "prefix": "ife",
    "body": [
