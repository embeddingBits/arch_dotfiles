{
  "Main Method": {
    "prefix": "psvm",
    "body": [
      "public static void main(String[] args)",
      "{",
      "\t$0",
      "}"
    ],
    "description": "public static void main(String[] args)"
  },
  "Main Method": {
    "prefix": "class_main",
    "body": [
      "public class Main {",
      " ",
      "\tpublic static void main(String[] args)",
      "\t\t{",
      "\t\t\t$0",
      "\t\t}",
      "}"
    ],
    "description": "public static void main(String[] args)"
  },
  "Print Line": {
    "prefix": "sout",
    "body": [
      "System.out.println(${1:msg});"
    ],
    "description": "System.out.println(...)"
  },
  "Print Format": {
    "prefix": "printf",
    "body": [
      "System.out.printf(\"${1:%s}\\n\", ${2:args});"
    ],
    "description": "System.out.printf(...)"
  },
  "Print Error": {
    "prefix": "serr",
    "body": [
      "System.err.println(${1:msg});"
    ],
    "description": "System.err.println(...)"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "public class ${1:Name}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Public class definition"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "public interface ${1:Name}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Public interface definition"
  },
  "Extends": {
    "prefix": "extends",
    "body": [
      "public class ${1:Name} extends ${2:Base}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Class extends another class"
  },
  "Implements": {
    "prefix": "implements",
    "body": [
      "public class ${1:Name} implements ${2:Interface}",
