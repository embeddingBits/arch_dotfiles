  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "Do While Loop": {
    "prefix": "dowhile",
    "body": [
      "do",
      "{",
      "\t$0",
