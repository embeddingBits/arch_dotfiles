      "\t$0",
      "}"
    ],
    "description": "Class implements an interface"
  },
  "Abstract Class": {
    "prefix": "abstract",
    "body": [
      "public abstract class ${1:Name}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Abstract class definition"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "public enum ${1:Name}",
      "{",
      "\t${2:VALUE}",
      "}"
    ],
    "description": "Enum definition"
  },
  "Method": {
    "prefix": "method",
    "body": [
