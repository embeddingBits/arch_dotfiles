      "case ${2:value}:",
      "\t$3",
      "\tbreak;",
      "default:",
      "\t$0",
      "\tbreak;",
      "}"
    ],
    "description": "Switch statement"
  },
  "Try Catch": {
    "prefix": "try",
    "body": [
      "try",
      "{",
      "\t$1",
      "} catch (${2:Exception} ${3:e})",
